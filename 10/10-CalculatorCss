/*Calculator CSS */
body{
  background-color:rgb(25,25,25);
  color:white;
  font-family:'Arial';
}

.numberButton{
  background-color:rgb(55, 50, 50);
  color: white;
  font-size:22px;
  padding:9px 16px;
  margin-right:4px;
  width:50px;
  height:50px;
  border-radius:60%;
  border:none;
  cursor:pointer;
}

.mathButtons{
  background-color:rgb(252, 134, 44);
  color: white;
  font-size:22px;
  padding:9px 16px;
  margin-right:4px;
  width:50px;
  height:50px;
  border-radius:60%;
  border:none;
  cursor:pointer;
}

.clearButton{
  font-size:15px;
  display:flex;
  justify-content:center;
  align-items:center;
  width:50px;
  height:50px;
  border-radius:60%;
}

.display{
  font-size:40px;
  margin-top:5px;
  margin-bottom:10px;
}
